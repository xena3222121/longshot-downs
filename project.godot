; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Longshot Downs"
run/main_scene="res://scenes/TitleScreen.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[autoload]

Bankroll="*res://scripts/autoload/Bankroll.gd"
SteamManager="*res://scripts/autoload/SteamManager.gd"
Career="*res://scripts/autoload/Career.gd"
AudioManager="*res://scripts/autoload/AudioManager.gd"
Settings="*res://scripts/autoload/Settings.gd"
Announcer="*res://scripts/autoload/Announcer.gd"
UITheme="*res://scripts/autoload/UITheme.gd"
ScreenFade="*res://scripts/autoload/ScreenFade.gd"
InputHints="*res://scripts/autoload/InputHints.gd"
RaceScheduler="*res://scripts/autoload/RaceScheduler.gd"

[audio]

general/text_to_speech=true

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=3
anti_aliasing/quality/screen_space_aa=1
environment/defaults/default_clear_color=Color(0.016, 0.024, 0.043, 1)
environment/glow/upscale_mode=1
lights_and_shadows/positional_shadow/atlas_size=4096
